# Site Guard AI staging settings (template, placeholders only). Copy it outside the checkout, for example to
# /etc/siteguard/staging.env (chmod 600), and replace every CHANGE value with a staging-only value. Never reuse
# production secrets and never copy production data into staging. A copy inside the repository (*.env) is
# git-ignored. The API refuses to start while a CHANGE value, an http URL or a weak JWT secret is left in place.
#
# Used by docker-compose.staging.yml through --env-file. Fixed there and not settable here: SITEGUARD_ENV=staging,
# SITEGUARD_SEED_DEMO_DATA=false, SITEGUARD_DATABASE_URL (the stack's own database) and SITEGUARD_EVIDENCE_DIR (the
# stack's own volume). Only the settings below reach the containers.

# Database password for this stack's PostgreSQL (letters, digits, - and _ keep the URL simple).
POSTGRES_PASSWORD=CHANGE-staging-db-password

# At least 32 random characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
SITEGUARD_JWT_SECRET=CHANGE-staging-jwt-secret

# The https address of the staging web app (used in notification links and as the allowed browser origin).
SITEGUARD_PUBLIC_WEB_URL=https://CHANGE-staging-host.example.com

# The browser talks only to the web app, so the API needs no cross-origin callers. If you add any, https only.
SITEGUARD_CORS_ORIGINS=
SITEGUARD_LOGIN_RATE_LIMIT_PER_MINUTE=10

# External notification delivery stays off in staging: disabled | log (log writes to the API log, sends nothing).
SITEGUARD_NOTIFICATION_EMAIL_ADAPTER=disabled

# AI provider: rules (offline, deterministic) or anthropic with a staging-only API key.
SITEGUARD_AI_PROVIDER=rules
ANTHROPIC_API_KEY=

# Loopback ports on the staging host (the TLS proxy forwards to the web port).
STAGING_WEB_PORT=3000
STAGING_API_PORT=8000
STAGING_DB_PORT=5433

# Images to run. Defaults build from this checkout; set registry tags to run exactly what CI built.
# SITEGUARD_API_IMAGE=<registry>/siteguard-api:<git sha>
# SITEGUARD_WEB_IMAGE=<registry>/siteguard-web:<git sha>
