# Copy to .env and change every value marked CHANGE. Never commit .env.
# local | test | demo | staging | production. staging and production refuse unsafe settings at startup.
SITEGUARD_ENV=local
SITEGUARD_JWT_SECRET=CHANGE-to-a-long-random-string
SITEGUARD_CORS_ORIGINS=http://localhost:3000
# Demo users share a known password: seeding defaults to on only for local, test and demo.
SITEGUARD_SEED_DEMO_DATA=true
SITEGUARD_DEMO_PASSWORD=siteguard-demo
# The Docker image runs Alembic migrations and sets SITEGUARD_AUTO_CREATE_SCHEMA=false itself.
POSTGRES_PASSWORD=CHANGE-local-db-password

# AI provider: "rules" runs fully offline. "anthropic" uses Claude for agent reasoning and falls back
# to rules on any failure. ANTHROPIC_API_KEY is read by the Anthropic SDK.
SITEGUARD_AI_PROVIDER=rules
SITEGUARD_ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# Knowledge documents and retrieval (docs/ENVIRONMENT.md). Defaults shown.
# SITEGUARD_DOCUMENT_MAX_BYTES=26214400
# SITEGUARD_CHUNK_STRATEGY=heading
# SITEGUARD_RETRIEVAL_MODE=hybrid
# SITEGUARD_PARSER_TIMEOUT_SECONDS=60
# SITEGUARD_PARSER_MEMORY_MB=1024

# Email delivery of notifications: disabled | log | smtp (smtp is refused in local and test). Defaults shown.
# SITEGUARD_NOTIFICATION_EMAIL_ADAPTER=disabled
# SITEGUARD_NOTIFICATION_MAX_ATTEMPTS=3
# SITEGUARD_SMTP_HOST=smtp.example.com
# SITEGUARD_SMTP_PORT=587
# SITEGUARD_SMTP_USERNAME=
# SITEGUARD_SMTP_PASSWORD=
# SITEGUARD_SMTP_FROM=siteguard@example.com

# Vision analysis of photo evidence: baseline (image-quality checks only) | anthropic (sends photos to Claude).
# SITEGUARD_VISION_PROVIDER=baseline
# SITEGUARD_VISION_RATE_LIMIT_PER_MINUTE=30
