# Copy to .env and change every value marked CHANGE. Never commit .env (it is git-ignored).
# docker compose reads this file; `make run` reads backend/.env if present, otherwise the defaults below.

# local | test | demo | staging | production
SITEGUARD_ENV=local
# Required outside local/test: a random value of at least 32 characters.
SITEGUARD_JWT_SECRET=CHANGE-to-a-long-random-string
# SITEGUARD_JWT_TTL_MINUTES=480
SITEGUARD_CORS_ORIGINS=http://localhost:3000
SITEGUARD_LOGIN_RATE_LIMIT_PER_MINUTE=10

# Database. Default is SQLite in backend/; docker compose sets PostgreSQL itself.
# SITEGUARD_DATABASE_URL=postgresql+psycopg://siteguard:CHANGE@localhost:5432/siteguard
POSTGRES_PASSWORD=CHANGE-local-db-password

# Evidence files are stored outside the database.
# SITEGUARD_EVIDENCE_DIR=./evidence_store
# SITEGUARD_EVIDENCE_MAX_BYTES=10485760

# Demo data (known passwords) seeds by default only when SITEGUARD_ENV is local, test or demo.
# The API refuses to start with seeding on when SITEGUARD_ENV=production.
# SITEGUARD_SEED_DEMO_DATA=true
SITEGUARD_DEMO_PASSWORD=siteguard-demo

# AI provider: "rules" runs fully offline. "anthropic" uses Claude for agent reasoning and falls back
# to rules on any failure. ANTHROPIC_API_KEY is read by the Anthropic SDK.
SITEGUARD_AI_PROVIDER=rules
SITEGUARD_ANTHROPIC_MODEL=claude-opus-5-5
# SITEGUARD_AGENT_TIMEOUT_SECONDS=60
ANTHROPIC_API_KEY=
