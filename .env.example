# Copy to .env and change every value marked CHANGE. Never commit .env.
SITEGUARD_ENV=local
SITEGUARD_JWT_SECRET=CHANGE-to-a-long-random-string
SITEGUARD_CORS_ORIGINS=http://localhost:3000
SITEGUARD_LOGIN_RATE_LIMIT_PER_MINUTE=10
# Demo data (known passwords) seeds by default only when SITEGUARD_ENV is local, test or demo.
# The API refuses to start with seeding on when SITEGUARD_ENV=production.
# SITEGUARD_SEED_DEMO_DATA=true
SITEGUARD_DEMO_PASSWORD=siteguard-demo
POSTGRES_PASSWORD=CHANGE-local-db-password

# AI provider: "rules" runs fully offline. "anthropic" uses Claude for agent reasoning and falls back
# to rules on any failure. ANTHROPIC_API_KEY is read by the Anthropic SDK.
SITEGUARD_AI_PROVIDER=rules
SITEGUARD_ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
