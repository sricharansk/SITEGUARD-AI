# Copy to .env and change every value marked CHANGE. Never commit .env (it is git-ignored).
# docker compose reads this file; `make run` reads backend/.env if present, otherwise the defaults below.

# local | test | demo | staging | production
SITEGUARD_ENV=local
# Required outside local/test: a random value of at least 32 characters.
SITEGUARD_JWT_SECRET=CHANGE-to-a-long-random-string
# SITEGUARD_JWT_TTL_MINUTES=480
SITEGUARD_CORS_ORIGINS=http://localhost:3000
SITEGUARD_LOGIN_RATE_LIMIT_PER_MINUTE=10

# Database. Default is SQLite in backend/; docker compose sets PostgreSQL itself.
# SITEGUARD_DATABASE_URL=postgresql+psycopg://siteguard:CHANGE@localhost:5432/siteguard
POSTGRES_PASSWORD=CHANGE-local-db-password

# Evidence files are stored outside the database.
# SITEGUARD_EVIDENCE_DIR=./evidence_store
# SITEGUARD_EVIDENCE_MAX_BYTES=10485760

# Knowledge documents and retrieval.
# SITEGUARD_DOCUMENT_MAX_BYTES=26214400
# heading | page | semantic
# SITEGUARD_CHUNK_STRATEGY=heading
# SITEGUARD_CHUNK_MAX_CHARS=900
# Only "hashing" (offline, deterministic) exists today; a semantic model is open decision O5.
# SITEGUARD_EMBEDDING_PROVIDER=hashing
# hybrid (BM25 + vector) | lexical (BM25 only)
# SITEGUARD_RETRIEVAL_MODE=hybrid
# PDF and DOCX parsing runs in a child process with CPU-time and memory limits.
# SITEGUARD_PARSER_TIMEOUT_SECONDS=60
# SITEGUARD_PARSER_MEMORY_MB=1024

# Notifications. External delivery: disabled (default) | log | smtp (smtp is refused when SITEGUARD_ENV is local/test).
# SITEGUARD_NOTIFICATION_EMAIL_ADAPTER=disabled
# SITEGUARD_NOTIFICATION_MAX_ATTEMPTS=3
# SITEGUARD_SMTP_HOST=smtp.example.com
# SITEGUARD_SMTP_PORT=587
# SITEGUARD_SMTP_USERNAME=
# SITEGUARD_SMTP_PASSWORD=
# SITEGUARD_SMTP_FROM=siteguard@example.com
# SITEGUARD_SMTP_STARTTLS=true
# Base URL used in notification links.
# SITEGUARD_PUBLIC_WEB_URL=http://localhost:3000
# SITEGUARD_ESCALATION_OVERDUE_DAYS=7
# SITEGUARD_ESCALATION_UNREVIEWED_HOURS=24
# SITEGUARD_ESCALATION_REVIEW_HOURS=48

# Demo data (known passwords) seeds by default only when SITEGUARD_ENV is local, test or demo.
# The API refuses to start with seeding on when SITEGUARD_ENV=production.
# SITEGUARD_SEED_DEMO_DATA=true
SITEGUARD_DEMO_PASSWORD=siteguard-demo

# AI provider: "rules" runs fully offline. "anthropic" uses Claude for agent reasoning and falls back
# to rules on any failure. ANTHROPIC_API_KEY is read by the Anthropic SDK.
SITEGUARD_AI_PROVIDER=rules
SITEGUARD_ANTHROPIC_MODEL=claude-opus-5-5
# SITEGUARD_AGENT_TIMEOUT_SECONDS=60
ANTHROPIC_API_KEY=

# Web app (frontend/): server-side settings. For `npm run dev` put them in frontend/.env.local (git-ignored);
# docker compose sets SITEGUARD_API_URL for the web service itself.
# SITEGUARD_API_URL=http://localhost:8000
# Extra origins allowed to send POST/PATCH/DELETE when a reverse proxy rewrites the Host header.
# SITEGUARD_ALLOWED_ORIGINS=https://siteguard.example.com
# SITEGUARD_API_TIMEOUT_MS=300000
