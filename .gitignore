# Secrets and local environment files (only the template is tracked)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.proxy-ca.crt
secrets/

# Local databases and uploaded evidence
*.db
*.sqlite
*.sqlite3
evidence_store/

