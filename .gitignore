__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
*.egg-info/
build/
.coverage
htmlcov/

# Node / web app
node_modules/
.next/
coverage/
next-env.d.ts
*.tsbuildinfo
playwright-report/
test-results/
blob-report/

# Editors and OS
.idea/
.vscode/
.DS_Store
*.log

# Claude Code worktrees (local only)
.claude/worktrees/
